---
import type { Language } from '../data/content';
import { gamesContent } from '../data/games';
interface Props { lang: Language; base: string; }
const { lang, base } = Astro.props;
const t = gamesContent[lang];
const symbol = `${base}/images/jinjin-symbol-128.webp`;
---
<section class="games wrap" aria-labelledby="games-title">
  <header class="games-heading">
    <div><h1 id="games-title">{t.title}<span aria-hidden="true">.</span></h1><p>{t.intro}</p></div>
    <div class="games-mark" aria-hidden="true"><img src={symbol} alt="" width="96" height="96" /><span>PLAY WITH JINJIN</span></div>
  </header>
  <div class="games-list-heading"><h2>{t.list}</h2><p>{t.preview}</p></div>
  <ul class="game-list">
    {t.games.map(game => <li class="game-card">
      <div class:list={['game-cover', `cover-${game.id}`]} aria-hidden="true">
        {game.id === 'quiz' && <div class="quiz-art"><span class="quiz-sheet"><img src={symbol} alt="" width="100" height="100" /></span><span class="question">?</span><span class="quiz-answer">✓</span></div>}
        {game.id === 'memory' && <div class="memory-art">{[true, false, false, true].map(face => <span class:list={['memory-tile', { 'face-up': face }]}>{face ? <img src={symbol} alt="" width="72" height="72" /> : <span>J</span>}</span>)}</div>}
        {game.id === 'puzzle' && <div class="puzzle-art">{[0, 1, 2, 3].map(piece => <span class={`puzzle-piece piece-${piece}`} style={`--piece-image: url('${symbol}')`}></span>)}</div>}
      </div>
      <div class="game-body"><span class="game-category">{game.category}</span><h3>{game.title}</h3><p>{game.description}</p><button type="button" disabled aria-label={`${game.title} · ${t.soon}`}>{t.soon}<span aria-hidden="true">↗</span></button></div>
    </li>)}
  </ul>
</section>
<style>
  .games { padding-block:clamp(48px,7vw,96px) clamp(72px,9vw,128px); min-height:calc(100svh - 98px); }
  .games-heading { display:flex; justify-content:space-between; align-items:center; gap:24px; margin-bottom:64px; }
  .games-heading h1 { font-family:inherit; font-size:clamp(38px,5vw,68px); font-weight:600; letter-spacing:-.055em; line-height:1.2; }
  .games-heading h1>span { color:var(--accent); }
  .games-heading p { margin-top:20px; color:var(--muted); font-size:clamp(16px,1.4vw,19px); line-height:1.7; }
  .games-mark { display:grid; justify-items:center; gap:8px; padding-inline:24px; transform:rotate(6deg); }
  .games-mark span { font-size:9px; font-weight:600; letter-spacing:.16em; }
  .games-list-heading { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:24px; }
  .games-list-heading h2 { font-family:inherit; font-size:20px; font-weight:600; letter-spacing:-.03em; }
  .games-list-heading p { font-size:13px; color:var(--muted); line-height:1.7; }
  .game-list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; list-style:none; margin:0; padding:0; }
  .game-card { overflow:hidden; border:1px solid color-mix(in srgb,var(--line) 65%,transparent); border-radius:16px; background:#fcfaf6; display:flex; flex-direction:column; }
  .game-cover { height:240px; display:grid; place-items:center; overflow:hidden; }
  .cover-quiz { background:#eaded0; }
  .cover-memory { background:#e3e5dc; }
  .cover-puzzle { background:#e8dfd9; }
  .game-body { padding:26px; display:flex; flex-direction:column; flex:1; }
  .game-category { color:var(--accent); font-size:12px; font-weight:500; }
  .game-body h3 { font-family:inherit; font-weight:600; font-size:25px; line-height:1.4; letter-spacing:-.035em; margin-top:10px; }
  .game-body p { margin:12px 0 28px; color:var(--muted); font-size:15px; line-height:1.8; }
  .game-body button { display:flex; justify-content:space-between; align-items:center; width:100%; min-height:46px; margin-top:auto; padding:10px 16px; border:0; border-radius:8px; background:var(--surface); color:var(--muted); font-size:13px; cursor:default; }
  .quiz-art { position:relative; width:190px; height:170px; }
  .quiz-sheet { position:absolute; left:8px; top:12px; width:125px; height:150px; display:grid; place-items:center; border-radius:12px; background:#fcfaf6; transform:rotate(-12deg); box-shadow:0 8px 16px #292a270c; }
  .question { position:absolute; right:0; top:0; display:grid; place-items:center; width:80px; height:80px; border-radius:50%; background:var(--accent); color:var(--paper); font-size:52px; font-weight:500; transform:rotate(12deg); }
  .quiz-answer { position:absolute; bottom:0; right:20px; font-size:42px; color:var(--ink); transform:rotate(-8deg); }
  .memory-art { display:grid; grid-template-columns:repeat(2,76px); gap:10px; transform:rotate(-8deg); }
  .memory-tile { display:grid; place-items:center; width:76px; height:86px; background:#858a76; border:4px solid #fcfaf6; border-radius:8px; color:#fcfaf6; box-shadow:0 5px 12px #292a270c; }
  .memory-tile>span { font-size:34px; font-family:var(--serif); }
  .memory-tile.face-up { background:#fcfaf6; }
  .puzzle-art { display:grid; grid-template-columns:repeat(2,82px); gap:5px; transform:rotate(6deg); }
  .puzzle-piece { width:82px; height:82px; border-radius:6px; background-color:#fcfaf6; background-image:var(--piece-image); background-size:164px 164px; background-repeat:no-repeat; box-shadow:0 5px 12px #292a270c; }
  .piece-1 { background-position:right top; }
  .piece-2 { background-position:left bottom; }
  .piece-3 { background-position:right bottom; transform:translate(12px,10px) rotate(10deg); }
  @media(max-width:1000px) { .game-list { gap:16px; } .game-body { padding:20px; } .game-cover { height:210px; } .game-body h3 { font-size:22px; } }
  @media(max-width:760px) { .games-heading { margin-bottom:40px; } .games-mark { display:none; } .game-list { grid-template-columns:1fr; gap:24px; } .game-cover { height:220px; } .game-body { padding:24px; } .games-list-heading p { max-width:32ch; } }
</style>
