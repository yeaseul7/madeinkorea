---
import type { Language } from '../data/content';
import JinjinPot from './JinjinPot.astro';
import { gamesContent } from '../data/games';
interface Props { lang: Language; base: string; }
const { lang, base } = Astro.props;
const t = gamesContent[lang];
---
<section class="games wrap" aria-labelledby="games-title">
  <h1 class="games-label" id="games-title">{t.label}</h1>
  <ul class="game-list">
    {t.games.map(game => <li><a class="game-card" href={`${base}/${lang}/games/${game.id}/`}>
      <div class="game-cover" aria-hidden="true" style={`background-image:url('${base}/images/jinjin-yard.svg')`}>
        <div class="preview-pots">{[false,true,false].map(up => <span class:list={['preview-pot',{'is-up':up}]}><JinjinPot base={base} /></span>)}</div>
      </div>
      <div class="game-caption"><h2>{game.title}</h2><span aria-hidden="true">↗</span></div>
    </a></li>)}
  </ul>
</section>
<style>
  :global(.games-page #main) { background:#fff; }
  .games { padding-block:32px 80px; min-height:65svh; }
  .games-label { margin-bottom:24px; font-family:inherit; font-size:14px; font-weight:500; letter-spacing:0; line-height:1.5; color:var(--muted); }
  .game-list { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:24px; list-style:none; margin:0; padding:0; }
  .game-card { display:block; border:1px solid #e8e8e4; background:#fff; border-radius:4px; overflow:hidden; transition:box-shadow .2s; }
  .game-card:hover { box-shadow:0 5px 18px #292a2712; }
  .game-cover { position:relative; aspect-ratio:16/10; background-size:cover; background-position:center; overflow:hidden; }
  .preview-pots { position:absolute; inset:26% 12% 10%; display:flex; gap:7%; align-items:end; }
  .preview-pot { position:relative; display:block; width:29%; height:95%; }
  .preview-pot:nth-child(2) { margin-bottom:8%; }
  .game-caption { display:flex; justify-content:space-between; align-items:center; padding:14px 16px; gap:12px; }
  .game-caption h2 { font-family:inherit; font-size:15px; font-weight:500; line-height:1.5; letter-spacing:0; }
  .game-caption>span { color:var(--muted); font-size:14px; }
  @media(max-width:1000px) { .game-list { grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; } }
  @media(max-width:700px) { .game-list { grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; } }
  @media(max-width:440px) { .game-list { grid-template-columns:minmax(0,1fr); max-width:340px; } }
  @media(prefers-reduced-motion:reduce) { .game-card { transition:none; } }
</style>
