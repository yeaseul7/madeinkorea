---
import type { Language } from '../data/content';
import { catchContent } from '../data/jinjin-catch';
import JinjinPot from './JinjinPot.astro';
interface Props { lang: Language; base: string; }
const { lang, base } = Astro.props;
const t = catchContent[lang];
---
<section class="catch-game wrap" id="jinjin-catch" aria-labelledby="catch-title" data-copy={JSON.stringify(t)}>
  <div class="catch-heading"><a href={`${base}/${lang}/games/`}>← {t.back}</a><h1 id="catch-title">{t.title}</h1><span class="heading-spacer" aria-hidden="true"></span></div>
  <div class="catch-cabinet" style={`--catch-props:url('${base}/images/games/jinjin-catch/props.png');--catch-characters:url('${base}/images/games/jinjin-catch/characters.png')`}>
    <div class="catch-timer time-counter" style="--time-left:1">
      <div class="timer-track" role="progressbar" aria-label={t.time} aria-valuemin="0" aria-valuemax="30" aria-valuenow="30" data-catch-timer><span class="timer-fill"></span><span class="timer-runner" aria-hidden="true">🦴</span></div>
    </div>
    <div class="catch-field" role="group" aria-label={t.field} style={`background-image:url('${base}/images/jinjin-yard-painted.png')`}>
      <div class="catch-hud floating-hud">
        <span class="hud-caption" hidden><small data-catch-level>LEVEL 1</small></span>
        <div class="floating-score" aria-label={t.score}><span>Score</span><i class="score-bone" aria-hidden="true"></i><strong data-catch-score>0</strong></div>
      </div>
      <div class="catch-pots">{Array.from({length:9},(_,i) => <button class="catch-pot" type="button" data-pot={i} aria-label={t.hole.replace('{n}',String(i+1))} disabled><JinjinPot base={base}/><span class="pot-key" aria-hidden="true">{i+1}</span><span class="catch-pop" aria-hidden="true"><strong class="catch-points">{t.hit}</strong><small class="catch-combo-pop" hidden></small></span></button>)}</div>
      <div class="catch-overlay">
        <div class="catch-dialog"><span class="dialog-paw" aria-hidden="true">✦</span><h2 data-overlay-title>{t.ready}</h2><p data-overlay-body>{t.readyBody}</p><div class="catch-character-guide">{({'ko':['진진이','백구','황구','흑구'],'en':['Jinjin','White','Golden','Black'],'ja':['ジンジン','白犬','黄犬','黒犬']}[lang]).map((name,i)=><span><i class={`guide-character guide-${i}`} aria-hidden="true"></i><small>{name}</small><b data-result-kind={['jinjin','white','gold','black'][i]}>{i === 0 ? '+100' : '−50'}</b></span>)}</div><p class="catch-result-detail" data-result-detail hidden></p><div class="catch-personal-records"><div><span aria-hidden="true">♛</span><div><small>{t.bestScore}</small><strong data-best-score>—</strong></div></div><div><span aria-hidden="true">✦</span><div><small>{t.bestCombo}</small><strong data-best-combo>—</strong></div></div></div><p class="catch-record-message" data-record-message hidden></p><small class="catch-storage-note" data-storage-note>{t.savedNote}</small><button type="button" data-catch-start disabled>{t.start} <span aria-hidden="true">→</span></button><noscript><p>{t.nojs}</p></noscript></div>
      </div>
    </div>
    <div class="catch-toolbar"><p>{t.intro}</p><button type="button" data-catch-pause disabled>{t.pause} <span aria-hidden="true">Ⅱ</span></button></div>
  </div>
  <p class="visually-hidden" data-catch-announcement aria-live="polite" aria-atomic="true"></p>
</section>
<script>
  import { setupJinjinCatch } from '../scripts/jinjin-catch';
  setupJinjinCatch();
</script>
<style>
  :global(.games-page #main) { background:#fff; }
  .catch-game { padding-block:28px 56px; max-width:1000px; }
  .catch-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:22px; }
  .catch-heading a { color:var(--muted); font-size:13px; }
  .catch-heading h1 { font-family:inherit; font-size:20px; line-height:1.5; font-weight:600; letter-spacing:-.03em; }
  .heading-spacer { width:90px; }
  .catch-cabinet { overflow:hidden; border:1px solid #ded5c4; border-radius:14px; background:#faf7ee; }
  .catch-hud { display:flex; justify-content:space-between; align-items:center; padding:16px 28px; gap:20px; background:#fcfaf3; }
  .catch-hud>div { min-width:90px; display:grid; gap:3px; }
  .catch-hud div>span { font-size:11px; color:#6a675d; }
  .catch-hud strong { font-size:30px; line-height:1.2; font-variant-numeric:tabular-nums; font-weight:600; }
  .catch-hud strong small { font-size:13px; font-weight:400; }
  .time-counter { text-align:right; }
  .time-counter.is-low { color:var(--accent); }
  .hud-caption { text-align:center; font-size:21px; font-weight:600; letter-spacing:.12em; line-height:1; color:#4f6150; }
  .hud-caption small { font-size:8px; letter-spacing:.1em; }
  .catch-field { position:relative; aspect-ratio:1000/650; background-size:cover; background-position:center top; isolation:isolate; }
  .catch-pots { position:absolute; inset:23% 15% 4%; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); grid-template-rows:repeat(3,minmax(0,1fr)); gap:0 10%; }
  .catch-pot { position:relative; min-width:0; border:0; padding:0; background:none; cursor:pointer; touch-action:manipulation; -webkit-tap-highlight-color:transparent; }
  .catch-pot:disabled { cursor:default; }
  .catch-pot:focus-visible { outline:2px dashed #70472f; outline-offset:2px; border-radius:14px; }
  .pot-key { position:absolute; z-index:4; bottom:14%; left:0; right:0; text-align:center; font-size:11px; color:#e3ccb0a6; pointer-events:none; }
  .catch-pop { position:absolute; z-index:4; left:50%; top:4%; color:#b74332; background:#fff9e9; border-radius:50%; padding:5px 8px; font-size:20px; font-weight:700; transform:translate(-50%,0); opacity:0; pointer-events:none; }
  .is-hit .catch-pop { animation:catch-score 500ms ease-out both; }
  .catch-overlay { position:absolute; inset:0; z-index:5; display:grid; place-items:center; padding:20px; background:#4e51393a; backdrop-filter:blur(2px); }
  .catch-overlay[hidden] { display:none; }
  .catch-dialog { width:min(360px,100%); padding:30px; border:1px solid #fff8; border-radius:18px; background:#fffdf5f5; text-align:center; box-shadow:0 14px 45px #3e352e1a; }
  .dialog-paw { display:block; color:#b74332; font-size:25px; margin-bottom:12px; }
  .catch-dialog h2 { font-family:inherit; font-size:25px; font-weight:600; letter-spacing:-.04em; line-height:1.4; }
  .catch-dialog p { margin-top:12px; color:#68675e; font-size:14px; line-height:1.8; }
  .catch-dialog button { display:flex; justify-content:space-between; align-items:center; width:100%; margin-top:24px; padding:14px 20px; border:0; border-radius:9px; background:#526953; color:#fff; font:inherit; font-size:14px; cursor:pointer; }
  .catch-dialog button:disabled { opacity:.5; cursor:default; }
  .catch-toolbar { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:16px 24px; }
  .catch-toolbar p { color:#68675e; font-size:13px; line-height:1.7; }
  .catch-toolbar button { flex-shrink:0; padding:10px 14px; min-height:44px; background:transparent; border:1px solid #d6d0bf; border-radius:8px; color:#526953; font:inherit; font-size:12px; cursor:pointer; }
  .catch-toolbar button:disabled { opacity:.4; cursor:default; }
  @keyframes catch-score { 0% { opacity:1; transform:translate(-50%,4px); } 100% { opacity:0; transform:translate(-50%,-22px); } }
  @media(max-width:650px) { .catch-heading { gap:10px; } .catch-heading h1 { font-size:18px; } .heading-spacer { display:none; } .catch-hud { padding:14px 18px; } .catch-hud>div { min-width:65px; } .catch-hud strong { font-size:25px; } .hud-caption { font-size:17px; } .catch-field { aspect-ratio:3/4; } .catch-pots { inset:25% 8% 5%; gap:2% 5%; } .catch-toolbar { padding:12px 16px; align-items:start; } .catch-toolbar p { font-size:12px; } .catch-dialog { padding:24px; } .catch-dialog h2 { font-size:22px; } .pot-key { font-size:9px; } }
  @media(hover:none) { .pot-key { display:none; } }
  @media(prefers-reduced-motion:reduce) { .is-hit .catch-pop { animation:none; opacity:1; } }
</style>
<style>
  .combo-counter strong { font-size:21px; color:#526953; }
  @media(max-width:650px) { .hud-caption { display:block; font-size:11px; letter-spacing:.04em; } .catch-hud { gap:8px; } .combo-counter strong { font-size:18px; } }
</style>

<style>
.catch-character-guide { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; margin-top:18px; }
.catch-character-guide>span { display:grid; justify-items:center; gap:3px; }
.guide-character { width:100%; aspect-ratio:1; display:block; background-image:var(--catch-characters); background-size:200% 200%; }
.guide-1 { background-position:100% 0; }.guide-2 { background-position:0 100%; }.guide-3 { background-position:100% 100%; }
.catch-character-guide small { font-size:10px; }.catch-character-guide b { font-size:10px; color:#a3482c; }
.catch-dialog { width:min(400px,100%); border:2px solid #c8b698; background:#fffaf0; box-shadow:0 12px 0 #5c3b2714,0 20px 50px #3e352e22; }
.catch-dialog button { background:#d84a2e; border-radius:30px; font-weight:600; }
.hud-caption { background-image:var(--catch-props); background-size:200% 200%; background-position:100% 0; width:190px; padding-block:34px; font-size:18px; color:#542f1c; }
.catch-hud { padding-block:4px; background:#f4e6ce; }
.catch-pot.is-hit::after { content:''; position:absolute; width:60%; aspect-ratio:1; top:-15%; left:20%; background-image:var(--catch-props); background-size:200% 200%; background-position:100% 100%; pointer-events:none; animation:catch-score 500ms ease-out both; z-index:5; }
.catch-pot[data-feedback="wrong"].is-hit::after { display:none; }
.catch-pot[data-feedback="wrong"] .catch-pop { color:#aa442f; }
.catch-pot[data-feedback="correct"] .catch-pop { color:#285e9b; }
@media(max-width:650px) { .catch-hud { padding-block:14px; }.catch-character-guide { gap:4px; } }
</style>
<style>
/* High-contrast, stable numeric HUD; artwork stays outside the reading area. */
.catch-hud { display:grid; grid-template-columns:1fr 1.15fr 1fr; gap:12px; padding:16px; background:#302b24; }
.catch-hud .hud-caption { display:none; }
.catch-hud>div { min-width:0; min-height:88px; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:8px; padding:12px 8px; border:1px solid #dbc59e; border-radius:12px; background:#fff8e9; text-align:center; }
.catch-hud div>span { font-size:13px; font-weight:700; line-height:1.3; color:#56432c; letter-spacing:0; }
.catch-hud strong, .catch-hud .combo-counter strong { color:#302213; font-size:36px; line-height:1; font-weight:700; letter-spacing:-.035em; font-variant-numeric:tabular-nums; white-space:nowrap; }
.catch-hud .time-counter { background:#f5d88d; }
.catch-hud .time-counter strong { font-size:40px; }
.catch-hud .time-counter.is-low { background:#a92e22; border-color:#ffae83; }
.catch-hud .time-counter.is-low>span,.catch-hud .time-counter.is-low strong { color:#fff; }
.catch-hud strong small { margin-left:4px; font-size:17px; }
@media(max-width:650px) {
 .catch-hud { padding:10px; gap:8px; }
 .catch-hud>div { padding:10px 4px; min-height:76px; gap:8px; }
 .catch-hud div>span { font-size:10px; }
 .catch-hud strong,.catch-hud .combo-counter strong { font-size:25px; }
 .catch-hud .time-counter strong { font-size:30px; }
}
</style>

<style>
.catch-hud { grid-template-columns:1fr 1fr; }
.catch-timer { background:#fff5de; padding:12px 22px 20px; border-bottom:1px solid #dbc59e; --timer-color:#e6a149; text-align:left; }
.timer-label { display:flex; align-items:center; gap:8px; font-size:12px; font-weight:600; color:#60452d; margin-bottom:10px; }
.timer-paw { font-size:18px; }.timer-label strong { margin-left:auto; font-size:22px; font-variant-numeric:tabular-nums; line-height:1; color:#473021; }.timer-label small { font-size:12px; font-weight:500; }
.timer-track { position:relative; height:20px; border:2px solid #8b6240; border-radius:30px; background:#e5d2b1; box-shadow:inset 0 2px 3px #62412725,0 2px 0 #fff; }
.timer-fill { position:absolute; inset:2px; border-radius:30px; background:linear-gradient(0deg,var(--timer-color),#ffdb86); transform:scaleX(var(--time-left)); transform-origin:left center; }
.timer-runner { position:absolute; left:clamp(10px,calc(var(--time-left)*100%),calc(100% - 10px)); top:50%; display:grid; place-items:center; width:30px; height:30px; border:2px solid #9e7041; border-radius:50%; background:#fff9e9; font-size:19px; transform:translate(-50%,-50%) rotate(-20deg); box-shadow:0 2px 3px #61472825; }
.catch-timer.is-low { --timer-color:#dc5338; background:#fff0e5; }.catch-timer.is-low .timer-label strong { color:#ae3325; }.catch-timer.is-low .timer-fill { background:linear-gradient(0deg,#d7472c,#ff9c64); }
@media(max-width:650px) { .catch-timer { padding:10px 16px 17px; }.timer-label { font-size:11px; }.timer-label strong { font-size:20px; }.timer-track { height:18px; } }
</style>

<style>
.catch-field .floating-hud { position:absolute; z-index:4; inset:16px 22px auto; display:flex; align-items:start; justify-content:space-between; gap:20px; padding:0; background:none; pointer-events:none; }
.catch-field .floating-hud>div { min-height:0; min-width:0; padding:0; border:0; border-radius:0; background:none; box-shadow:none; }
.catch-field .floating-hud .floating-score { display:flex; flex-direction:row; align-items:center; justify-content:flex-end; gap:10px; text-align:right; }
.catch-field .floating-hud .floating-score>span { font-family:'DM Sans',sans-serif; font-size:29px; font-weight:700; color:#fff9cf; letter-spacing:-.025em; line-height:1; }
.catch-field .floating-hud .floating-score>strong { min-width:2ch; color:#fff; font-family:'DM Sans',sans-serif; font-size:40px; font-weight:700; line-height:1; letter-spacing:-.04em; }
.floating-score>span,.floating-score>strong { text-shadow:0 2px 0 #593922,2px 3px 0 #593922,-1px -1px 0 #593922,0 3px 5px #392316aa; }
.score-bone { display:block; width:32px; height:32px; background-image:var(--catch-props); background-size:200% 200%; background-position:0 100%; filter:drop-shadow(0 2px 1px #59392288); }
.catch-field .floating-hud .combo-counter { align-items:flex-start; gap:5px; text-shadow:0 1px 2px #392316,0 2px 4px #392316; }
.catch-field .floating-hud .combo-counter>span { color:#fff4d4; font-size:11px; }
.catch-field .floating-hud .combo-counter>strong { color:#fff4d4; font-size:23px; }
@media(max-width:650px) { .catch-field .floating-hud { inset:16px 14px auto; gap:12px; }.catch-field .floating-hud .floating-score { gap:6px; }.catch-field .floating-hud .floating-score>span { font-size:23px; }.catch-field .floating-hud .floating-score>strong { font-size:30px; }.score-bone { width:25px;height:25px; }.catch-field .floating-hud .combo-counter>span { font-size:9px; }.catch-field .floating-hud .combo-counter>strong { font-size:18px; } }
</style>

<style>
.catch-field .floating-hud { justify-content:flex-end; }
.catch-pop { display:flex; flex-direction:column; align-items:center; gap:4px; min-width:64px; padding:7px 12px; border-radius:12px; white-space:nowrap; z-index:6; box-shadow:0 3px 10px #51372222; }
.catch-points { font-size:22px; line-height:1; }.catch-combo-pop { font-size:12px; font-weight:800; color:#a85a17; line-height:1.3; }.catch-combo-pop[hidden] { display:none; }
.is-hit .catch-pop { animation-duration:750ms; }
@media(max-width:650px) { .catch-points { font-size:19px; }.catch-combo-pop { font-size:10px; }.catch-pop { min-width:54px; padding:6px 9px; } }
</style>
<style>
.catch-field .floating-hud .floating-score { padding:9px 14px; gap:8px; border:1px solid #ffedbbaa; border-radius:13px; background:#543c25c9; box-shadow:0 3px 0 #2d201b30, inset 0 1px 0 #fff2; backdrop-filter:blur(5px); }
.catch-field .floating-hud .floating-score>span { font-size:23px; }
.catch-field .floating-hud .floating-score>strong { font-size:34px; }
@media(max-width:650px) { .catch-field .floating-hud .floating-score { padding:8px 11px; gap:6px; }.catch-field .floating-hud .floating-score>span { font-size:19px; }.catch-field .floating-hud .floating-score>strong { font-size:28px; } }
</style>

<style>
.catch-result-detail[hidden] { display:none; }
.catch-dialog .catch-result-detail { font-size:12px; line-height:1.8; border-top:1px solid #dbc59e; padding-top:12px; }
:global([data-phase="ended"]) .catch-character-guide b { font-size:10px; line-height:1.5; text-align:center; }
</style>

<style>
.catch-personal-records { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:18px; padding-top:16px; border-top:1px dashed #d8bb8d; }
.catch-personal-records>div { display:flex; align-items:center; gap:10px; padding:12px; border-radius:12px; background:#f4e8cd; text-align:left; }
.catch-personal-records>div>span { font-size:27px; color:#b47c23; }
.catch-personal-records small { display:block; font-size:10px; color:#785333; line-height:1.5; }
.catch-personal-records strong { display:block; font-size:24px; line-height:1.2; color:#4a2c1b; font-variant-numeric:tabular-nums; }
.catch-dialog .catch-record-message { font-size:13px; font-weight:700; color:#b14326; margin-top:12px; }
.catch-record-message[hidden] { display:none; }.catch-storage-note { display:block; margin-top:12px; font-size:10px; line-height:1.7; color:#846f58; }
.catch-overlay { overflow-y:auto; }.catch-dialog { margin-block:auto; }
</style>
