---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import approvals from '../data/featured-videos.json';
import { selectFeatured } from '../../scripts/lib/youtube.mjs';
import type { Language } from '../data/content';

interface Props { lang: Language; }
const { lang } = Astro.props;
let cache = null;
try { cache = JSON.parse(readFileSync(resolve('.generated/videos.json'), 'utf8')); } catch { /* No approved metadata on a fresh local checkout. */ }
const video = selectFeatured(approvals, cache);
const t = {
  ko: { title: '오늘의 진돗개', intro: '영상으로 만나는 진돗개의 하루.', play: '영상 재생', watch: 'YouTube에서 보기', empty: '다음 이야기를 고르고 있어요.', soon: '진돗개와 함께하는 일상을 곧 소개할게요.', note: '재생하면 YouTube에 연결됩니다. 영상과 자막은 원본에서 제공하는 언어로 재생됩니다.', terms: 'YouTube 이용약관', privacy: 'Google 개인정보처리방침' },
  en: { title: 'Today’s Jindo', intro: 'A little glimpse into life with a Jindo.', play: 'Play video', watch: 'Watch on YouTube', empty: 'A new story is on its way.', soon: 'A handpicked glimpse of everyday life with a Jindo, coming soon.', note: 'Playing connects to YouTube. Audio and captions use the languages available in the original video.', terms: 'YouTube Terms', privacy: 'Google Privacy Policy' },
  ja: { title: '今日の珍島犬', intro: '動画で出会う、珍島犬の毎日。', play: '動画を再生', watch: 'YouTubeで見る', empty: '次の物語を選んでいます。', soon: '珍島犬と暮らす日々を、まもなくお届けします。', note: '再生するとYouTubeに接続します。音声と字幕は元の動画で提供される言語です。', terms: 'YouTube利用規約', privacy: 'Googleプライバシーポリシー' },
}[lang];
---
<section id="todays-jindo" class="section wrap today-jindo" aria-labelledby="today-title">
  <header class="today-heading"><div><p class="eyebrow">JINDO / EVERYDAY</p><h2 id="today-title">{t.title}</h2></div><p>{t.intro}</p></header>
  {video && <div class="today-feature" data-video-expiry={video.expiresAt}>
    <div class="today-player" data-video-id={video.id} data-video-title={video.title} data-language={lang}>
      <button class="today-poster" type="button" aria-label={`${t.play}: ${video.title}`}>
        <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" referrerpolicy="no-referrer" />
        <span class="today-play"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M8 4v16l13-8z" /></svg><span>{t.play}</span></span>
      </button>
    </div>
    <div class="today-caption"><div><p class="today-channel">{video.channel}</p><h3>{video.title}</h3></div><a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noreferrer">{t.watch} ↗</a></div>
    <p class="today-note">{t.note} <a href="https://www.youtube.com/t/terms" target="_blank" rel="noreferrer">{t.terms}</a> · <a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">{t.privacy}</a></p>
  </div>}
  <div class="today-empty" hidden={!!video}><span class="today-empty-mark" aria-hidden="true">▷</span><div><h3>{t.empty}</h3><p>{t.soon}</p></div></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-expiry]').forEach(feature => {
    const expire = () => {
      if (Date.parse(feature.dataset.videoExpiry || '') <= Date.now()) {
        feature.remove();
        const empty = document.querySelector<HTMLElement>('#todays-jindo .today-empty');
        if (empty) empty.hidden = false;
        return true;
      }
      return false;
    };
    if (expire()) return;
    document.addEventListener('visibilitychange', expire);
    const player = feature.querySelector<HTMLElement>('.today-player');
    player?.querySelector('button')?.addEventListener('click', () => {
      if (expire() || !/^[A-Za-z0-9_-]{11}$/.test(player.dataset.videoId || '')) return;
      const iframe = document.createElement('iframe');
      const url = new URL(`https://www.youtube-nocookie.com/embed/${player.dataset.videoId}`);
      url.searchParams.set('autoplay', '1');
      url.searchParams.set('playsinline', '1');
      url.searchParams.set('hl', player.dataset.language || 'en');
      iframe.src = url.href;
      iframe.title = player.dataset.videoTitle || 'YouTube';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      player.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>

<style>
  .today-jindo { max-width: 1120px; }
  .today-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 36px; }
  .today-heading .eyebrow { margin-bottom: 12px; }
  .today-heading > p { max-width: 28ch; color: var(--muted); line-height: 1.7; font-size: 17px; }
  .today-player { aspect-ratio: 16/9; min-height: 200px; overflow: hidden; background: var(--ink); }
  .today-poster { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: var(--ink); color: white; cursor: pointer; }
  .today-poster img { width: 100%; height: 100%; object-fit: contain; opacity: .85; transition: opacity .2s; }
  .today-poster:hover img { opacity: 1; }
  .today-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); display: flex; align-items: center; gap: 12px; padding: 18px 26px; white-space: nowrap; background: var(--accent); border-radius: 40px; font-size: 16px; }
  .today-player :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .today-caption { display: flex; justify-content: space-between; align-items: start; gap: 24px; margin-top: 24px; }
  .today-caption h3 { font-size: clamp(20px,2vw,27px); line-height: 1.5; overflow-wrap: anywhere; }
  .today-channel { font-size: 14px; color: var(--muted); margin-bottom: 8px; }
  .today-caption > a { white-space: nowrap; font-size: 14px; padding-block: 8px; text-decoration: underline; text-underline-offset: 5px; }
  .today-note { margin-top: 24px; font-size: 12px; line-height: 1.8; color: var(--muted); }
  .today-note a { text-decoration: underline; }
  .today-empty { display: flex; align-items: center; gap: 30px; padding: clamp(28px,5vw,64px); background: var(--surface); }
  .today-empty[hidden] { display: none; }
  .today-empty-mark { font-size: 48px; line-height: 1; color: var(--accent); }
  .today-empty h3 { font-size: 22px; margin-bottom: 8px; }
  .today-empty p { font-size: 16px; color: var(--muted); line-height: 1.7; }
  @media(max-width: 600px) {
    .today-heading, .today-caption { flex-direction: column; align-items: start; gap: 16px; }
    .today-heading > p { max-width: none; font-size: 16px; }
    .today-empty { flex-direction: column; align-items: start; gap: 18px; }
    .today-empty h3 { font-size: 19px; }
  }
</style>
