---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { selectVideos } from '../../scripts/lib/youtube.mjs';
import type { Language } from '../data/content';
interface Props { lang: Language; }
const { lang } = Astro.props;
let cache = null;
try { cache = JSON.parse(readFileSync(resolve('.generated/videos.json'), 'utf8')); } catch {}
const videos = selectVideos(cache);
const t = {
  ko: { title: '오늘의 진돗개', intro: '영상으로 만나는 진돗개의 하루.', play: '영상 재생', watch: 'YouTube에서 보기', empty: '잠시 쉬어가는 중이에요.', soon: '새로운 진돗개 영상을 곧 만나보세요.', note: '재생하면 YouTube에 연결됩니다. 영상과 자막은 원본에서 제공하는 언어로 재생됩니다.', terms: 'YouTube 이용약관', privacy: 'Google 개인정보처리방침' },
  en: { title: 'Today’s Jindo', intro: 'A little glimpse into life with a Jindo.', play: 'Play video', watch: 'Watch on YouTube', empty: 'More Jindo moments, coming soon.', soon: 'Check back soon for new videos.', note: 'Playing connects to YouTube. Audio and captions use the languages available in the original video.', terms: 'YouTube Terms', privacy: 'Google Privacy Policy' },
  ja: { title: '今日の珍島犬', intro: '動画で出会う、珍島犬の毎日。', play: '動画を再生', watch: 'YouTubeで見る', empty: 'ただいまひと休み中です。', soon: '新しい珍島犬の動画をお楽しみに。', note: '再生するとYouTubeに接続します。音声と字幕は元の動画で提供される言語です。', terms: 'YouTube利用規約', privacy: 'Googleプライバシーポリシー' },
}[lang];
---
<section id="todays-jindo" class="section wrap today-jindo" aria-labelledby="today-title">
  <header class="today-heading"><h2 id="today-title">{t.title}</h2><p>{t.intro}</p></header>
  {videos.length > 0 && <div class="today-feed" data-video-expiry={videos[0].expiresAt}>
    <div class="today-grid" id="today-video-list">
      {videos.map(video => <article class="today-card">
        <div class="today-player" data-video-id={video.id} data-video-title={video.title} data-language={lang}>
          <button class="today-poster" type="button" aria-label={`${t.play}: ${video.title}`}>
            <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" referrerpolicy="no-referrer" />
            <span class="today-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 4v16l13-8z" /></svg></span>
          </button>
        </div>
        <div class="today-caption"><p class="today-channel">{video.channel}</p><h3>{video.title}</h3><a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noreferrer">{t.watch} ↗</a></div>
      </article>)}
    </div>
    <p class="today-note">{t.note} <a href="https://www.youtube.com/t/terms" target="_blank" rel="noreferrer">{t.terms}</a> · <a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">{t.privacy}</a></p>
  </div>}
  <div class="today-empty" hidden={videos.length > 0}><span class="today-empty-mark" aria-hidden="true">▷</span><div><h3>{t.empty}</h3><p>{t.soon}</p></div></div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.today-feed').forEach(feed => {
    const expire = () => {
      if (Date.parse(feed.dataset.videoExpiry || '') <= Date.now()) {
        feed.remove();
        const empty = document.querySelector<HTMLElement>('#todays-jindo .today-empty');
        if (empty) empty.hidden = false;
        return true;
      }
      return false;
    };
    if (expire()) return;
    document.addEventListener('visibilitychange', expire);
    const posters = new Map<HTMLElement, Node>();
    feed.querySelectorAll<HTMLElement>('.today-player').forEach(player => {
      const poster = player.querySelector('button');
      if (poster) posters.set(player, poster.cloneNode(true));
    });
    let active: HTMLElement | null = null;
    feed.addEventListener('click', event => {
      const target = event.target as Element;
      const button = target.closest('.today-poster');
      const player = button?.closest<HTMLElement>('.today-player');
      if (!player || expire() || !/^[A-Za-z0-9_-]{11}$/.test(player.dataset.videoId || '')) return;
      if (active && posters.has(active)) active.replaceChildren(posters.get(active)!.cloneNode(true));
      const iframe = document.createElement('iframe');
      const url = new URL(`https://www.youtube-nocookie.com/embed/${player.dataset.videoId}`);
      url.searchParams.set('autoplay', '1'); url.searchParams.set('playsinline', '1'); url.searchParams.set('hl', player.dataset.language || 'en');
      iframe.src = url.href; iframe.title = player.dataset.videoTitle || 'YouTube';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'; iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      player.replaceChildren(iframe); active = player; iframe.focus();
    });
  });
</script>
<style>
  .today-jindo { max-width: 1120px; }
  .today-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 36px; }
  .today-heading > p { color: var(--muted); line-height: 1.7; font-size: 17px; }
  .today-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 40px 24px; }
  .today-card { min-width: 0; }
  .today-empty[hidden] { display: none; }
  .today-player { aspect-ratio: 16/9; min-height: 200px; overflow: hidden; background: var(--ink); }
  .today-poster { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: var(--ink); color: white; cursor: pointer; }
  .today-poster img { width: 100%; height: 100%; object-fit: cover; opacity: .9; transition: opacity .2s; }
  .today-poster:hover img { opacity: 1; }
  .today-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); display: grid; place-items: center; width: 56px; height: 56px; background: var(--accent); border-radius: 50%; }
  .today-player :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .today-caption { margin-top: 18px; }
  .today-caption h3 { font-size: 18px; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .today-channel { font-size: 13px; color: var(--muted); margin-bottom: 6px; }
  .today-caption > a { display: inline-block; font-size: 13px; margin-top: 14px; text-decoration: underline; text-underline-offset: 5px; }
  .today-note { margin-top: 32px; font-size: 12px; line-height: 1.8; color: var(--muted); }
  .today-note a { text-decoration: underline; }
  .today-empty { display: flex; align-items: center; gap: 30px; padding: clamp(28px,5vw,64px); background: var(--surface); }
  .today-empty-mark { font-size: 48px; line-height: 1; color: var(--accent); }
  .today-empty h3 { font-size: 22px; margin-bottom: 8px; }
  .today-empty p { font-size: 16px; color: var(--muted); line-height: 1.7; }
  @media(max-width: 1100px) { .today-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(max-width: 680px) {
    .today-grid { grid-template-columns: 1fr; gap: 36px; }
    .today-heading { flex-direction: column; align-items: start; gap: 16px; }
    .today-heading > p { font-size: 16px; }
    .today-empty { flex-direction: column; align-items: start; gap: 18px; }
    .today-empty h3 { font-size: 19px; }
  }
</style>
