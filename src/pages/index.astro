---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/en/`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta http-equiv="refresh" content={`0;url=${target}`}/><title>Jindo of Korea</title><meta name="robots" content="noindex"/></head><body><a href={target}>Meet the Jindo →</a></body></html>
